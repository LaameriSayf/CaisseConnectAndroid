<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content including RecyclerView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Champ de recherche -->
        <EditText
            android:id="@+id/searchField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rechercher un client"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp" />

        <!-- Boutons de tri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnSortAsc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tri A-Z"
                android:textColor="@android:color/white"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnSortDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Tri Z-A"
                android:textColor="@android:color/white"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Liste des clients -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Bouton Ajouter avec icône "+" à gauche -->
    <Button
        android:id="@+id/btnAddClient"
        android:layout_width="52dp"
        android:layout_height="53dp"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_background"
    android:contentDescription="Ajouter un client"
    android:drawableLeft="@drawable/plus"
    android:padding="16dp"
    android:rotationX="15"
    android:text=""
    android:textColor="@android:color/white" />


</FrameLayout>
